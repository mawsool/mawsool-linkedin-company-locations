{
  "$schema": "https://apify.com/schemas/v1/actor.ide.json",
  "actorSpecification": 1,
  "name": "mawsool-linkedin-company-locations",
  "title": "LinkedIn Company Locations Scraper",
  "description": "Get office locations from a LinkedIn company URL: address lines and which office is primary. From $1 per 1,000 companies.",
  "seoTitle": "LinkedIn Company Locations Scraper",
  "seoDescription": "Scrape LinkedIn company office locations, address lines, and the primary office. $1 per 1,000 companies.",
  "categories": [
    "LEAD_GENERATION",
    "SOCIAL_MEDIA"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 1024,
  "defaultRunOptions": {
    "build": "latest",
    "timeoutSecs": 21600,
    "memoryMbytes": 256
  },
  "environmentVariables": {
    "ACTOR_SLICE": "locations",
    "CHARGE_EVENT": "company-locations",
    "COMPANY_API_KEY": "@mawsoolCompanyApiKey"
  },
  "meta": {
    "templateId": "ts-empty",
    "generatedBy": "Cursor Agent"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "pricing": "./pay_per_event.json",
  "dockerfile": "../Dockerfile"
}
